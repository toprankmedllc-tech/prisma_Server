generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  studentType            StudentType?
  targetExam             ExamType?
  targetTestDate         DateTime?
  graduationYear         Int?
  university             String?
  country                String?
  timezone               String?
  acceptedTerms          Boolean                 @default(false)
  acceptedPrivacy        Boolean                 @default(false)
  role                   Role                    @default(STUDENT)
  isActive               Boolean                 @default(true)
  emailVerifiedAt        DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  reviewedQuestions      String[]                @default([])
  skippedQuestions       String[]                @default([])
  assignedQuestions      String[]                @default([])
  preferredSubjects      String[]                @default([])
  diamonds               Int                     @default(10)
  arenaBattlesAsPlayer1  ArenaBattle[]           @relation("ArenaPlayer1")
  arenaBattlesAsPlayer2  ArenaBattle[]           @relation("ArenaPlayer2")
  arenaAnswers           ArenaBattleAnswer[]
  arenaGuildMemberships  ArenaGuildMember[]
  guildVotesReceived     ArenaGuildVote[]        @relation("GuildCandidate")
  guildVotesCast         ArenaGuildVote[]        @relation("GuildVoter")
  arenaLeaderboard       ArenaLeaderboardEntry?
  teamBattleAnswers      ArenaTeamBattleAnswer[]
  teamBattleMemberships  ArenaTeamBattleMember[]
  receivedMessages       ChatMessage[]           @relation("ChatReceiver")
  sentMessages           ChatMessage[]           @relation("ChatSender")
  conversations          Conversation[]
  createdExams           Exam[]                  @relation("ExamCreator")
  examAttempts           ExamAttempt[]
  flashcards             Flashcard[]
  receivedFriendRequests Friend[]                @relation("FriendAddressee")
  sentFriendRequests     Friend[]                @relation("FriendRequester")
  guildMessages          GuildMessage[]
  attempts               QuestionAttempt[]
  questionFlags          QuestionFlag[]
  questionHighlights     QuestionHighlight[]
  questionResponses      QuestionResponse[]
  sessions               Session[]
  studySessions          StudySession[]
  userStats              UserStats?

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  text       String
  letter     String?
  isCorrect  Boolean
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id])
}

model WrongOption {
  id            String   @id @default(cuid())
  questionId    String
  letter        String
  text          String
  explanation   String?
  buzzwordCombo String?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  question      Question @relation(fields: [questionId], references: [id])
}

model Vitals {
  id              String   @id @default(cuid())
  questionId      String   @unique
  bloodPressure   String?
  heartRate       Int?
  pulseOximetry   Int?
  temperature     Float?
  respiratoryRate Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  question        Question @relation(fields: [questionId], references: [id])
}

model QualityReview {
  id                 String   @id @default(cuid())
  questionId         String   @unique
  medicalAccuracy    String?
  usmleStyle         String?
  explanationQuality String?
  originality        String?
  grammar            String?
  vignetteReview     String?
  buzzwordReview     String?
  reviewedBy         String?
  reviewedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt
  question           Question @relation(fields: [questionId], references: [id])
}

model AiReview {
  id                         String            @id @default(cuid())
  questionId                 String
  verdict                    AiReviewVerdict
  usmleStyleScore            Int?
  medicalAccuracyScore       Int?
  hallucinationRiskScore     Int?
  explanationQualityScore    Int?
  clinicalRelevanceScore     Int?
  grammaticalQualityScore    Int?
  usmleStyleFeedback         String?
  medicalAccuracyFeedback    String?
  hallucinationDetails       String?
  explanationQualityFeedback String?
  clinicalRelevanceFeedback  String?
  grammaticalFeedback        String?
  generalFeedback            String?
  reviewedByAi               String?
  tokenUsage                 Int?
  reviewDurationMs           Int?
  replacementQuestionId      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  revisionId                 String?
  attemptNumber              Int               @default(1)
  trigger                    AiReviewTrigger   @default(MANUAL)
  promptVersion              String            @default("v1")
  humanRejectionContext      Json?
  criticalIssues             Json?
  humanAiAgreement           Boolean?
  humanComment               String?
  humanAgree                 Boolean?
  humanReviewedBy            String?
  humanReviewedAt            DateTime?
  verificationVerdict        String?
  verificationAgrees         Boolean?
  verificationConfidence     Int?
  verificationReason         String?
  question                   Question          @relation(fields: [questionId], references: [id])
  revision                   QuestionRevision? @relation(fields: [revisionId], references: [id])

  @@map("ai_reviews")
}

model GenerationJob {
  id            String   @id @default(cuid())
  userId        String?
  params        Json
  status        String   @default("queued")
  questionIds   String[] @default([])
  errorMessage  String?
  questionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Question {
  id                         String                    @id @default(cuid())
  stem                       String
  leadInQuestion             String?
  explanation                String
  source                     QuestionSource            @default(HUMAN_GENERATED)
  sourceType                 QuestionSourceType?
  sourceRow                  Int?
  sourceFile                 String?
  qid                        String?
  topicId                    String
  system                     String?
  discipline                 String?
  subsystem                  String?
  cognitiveLevel             CognitiveLevel?
  difficulty                 Difficulty
  trapType                   String?
  patientProfile             String?
  chiefComplaint             String?
  keySymptoms                String[]                  @default([])
  physicalExam               String?
  mainClue                   String?
  supportingClue             String?
  correctAnswerLetter        String?
  correctAnswerText          String?
  stepByStepReasoning        String?
  educationalObjective       String?
  buzzwords                  String[]                  @default([])
  buzzwordCombinationCorrect String?
  relatedConcepts            String[]                  @default([])
  suggestedImages            String?
  importedAt                 DateTime?
  importedBy                 String?
  isPublished                Boolean                   @default(false)
  reviewed                   Boolean                   @default(false)
  reviewedBy                 String?
  reviewNotes                Json?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  rejected                   Boolean                   @default(false)
  originalQuestionId         String?
  arenaBattleAnswers         ArenaBattleAnswer[]
  arenaBattleQuestions       ArenaBattleQuestion[]
  arenaTeamBattleAnswers     ArenaTeamBattleAnswer[]
  arenaTeamBattleQuestions   ArenaTeamBattleQuestion[]
  choices                    Choice[]
  examQuestions              ExamQuestion[]
  qualityReview              QualityReview?
  originalQuestion           Question?                 @relation("QuestionReplacements", fields: [originalQuestionId], references: [id])
  aiReplacements             Question[]                @relation("QuestionReplacements")
  topic                      Topic                     @relation(fields: [topicId], references: [id])
  attempts                   QuestionAttempt[]
  questionFlags              QuestionFlag[]
  questionHighlights         QuestionHighlight[]
  references                 QuestionReference[]
  questionResponses          QuestionResponse[]
  revisions                  QuestionRevision[]
  tags                       QuestionTag[]
  studySessionQuestions      StudySessionQuestion[]
  vitals                     Vitals?
  wrongOptions               WrongOption[]
  aiReviews                  AiReview[]
}

model QuestionRevision {
  id             String               @id @default(cuid())
  questionId     String
  revisionNumber Int
  revisionType   QuestionRevisionType
  snapshot       Json
  reason         String?
  createdBy      String?
  createdAt      DateTime             @default(now())
  question       Question             @relation(fields: [questionId], references: [id])
  aiReviews      AiReview[]

  @@unique([questionId, revisionNumber])
  @@index([questionId, createdAt])
}

model QuestionAttempt {
  id               String   @id @default(cuid())
  userId           String
  questionId       String
  selectedChoiceId String?
  isCorrect        Boolean
  timeSpentSec     Int
  attemptedAt      DateTime @default(now())
  question         Question @relation(fields: [questionId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

model QuestionReference {
  questionId  String
  referenceId String
  question    Question  @relation(fields: [questionId], references: [id])
  reference   Reference @relation(fields: [referenceId], references: [id])

  @@id([questionId, referenceId])
}

model Reference {
  id        String              @id @default(cuid())
  title     String
  source    String
  url       String?
  questions QuestionReference[]
}

model UserStats {
  id             String   @id @default(uuid())
  userId         String   @unique
  totalQuestions Int      @default(0)
  correctAnswers Int      @default(0)
  accuracy       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model QuestionResponse {
  id           String   @id @default(uuid())
  userId       String
  questionId   String
  isCorrect    Boolean
  responseTime Int      @default(0)
  createdAt    DateTime @default(now())
  question     Question @relation(fields: [questionId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Document {
  id        String          @id @default(cuid())
  title     String
  source    String?
  status    DocumentStatus
  createdAt DateTime        @default(now())
  charCount Int?
  content   String?
  fileType  String?
  metadata  Json?
  updatedAt DateTime        @updatedAt
  chunks    DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  vectorId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])
}

model ExamQuestion {
  examId     String
  questionId String
  blockIndex Int      @default(0)
  exam       Exam     @relation(fields: [examId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@id([examId, questionId])
  @@index([examId, blockIndex])
}

model StudySession {
  id           String                 @id @default(cuid())
  userId       String
  title        String
  description  String?
  questionType QuestionSourceType?
  difficulty   Difficulty?
  subjectId    String?
  status       StudySessionStatus     @default(IN_PROGRESS)
  startedAt    DateTime               @default(now())
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  subject      Subject?               @relation(fields: [subjectId], references: [id])
  user         User                   @relation(fields: [userId], references: [id])
  questions    StudySessionQuestion[]

  @@index([userId, status])
}

model StudySessionQuestion {
  id                String                     @id @default(cuid())
  sessionId         String
  questionId        String
  order             Int
  status            StudySessionQuestionStatus @default(UNANSWERED)
  firstDisplayedAt  DateTime?
  lastDisplayedAt   DateTime?
  totalTimeSpentSec Int                        @default(0)
  attemptCount      Int                        @default(0)
  pointsAwarded     Int                        @default(0)
  answeredAt        DateTime?
  answerAttempts    StudyAnswerAttempt[]
  question          Question                   @relation(fields: [questionId], references: [id])
  session           StudySession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@unique([sessionId, order])
  @@index([sessionId, status])
}

model StudyAnswerAttempt {
  id                String               @id @default(cuid())
  sessionQuestionId String
  selectedChoiceId  String?
  isCorrect         Boolean
  timeSpentSec      Int                  @default(0)
  attemptedAt       DateTime             @default(now())
  sessionQuestion   StudySessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)

  @@index([sessionQuestionId, attemptedAt])
}

model QuestionFlag {
  id         String              @id @default(cuid())
  userId     String
  questionId String
  context    QuestionFlagContext
  contextId  String
  isFlagged  Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, context, contextId])
  @@index([userId, context, contextId])
}

model QuestionHighlight {
  id         String              @id @default(cuid())
  userId     String
  questionId String
  context    QuestionFlagContext
  contextId  String
  textRoot   String
  start      Int
  end        Int
  text       String
  color      String              @default("yellow")
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionId, context, contextId])
}

model ExamAttempt {
  id                      String            @id @default(cuid())
  examId                  String
  userId                  String
  score                   Float             @default(0)
  startedAt               DateTime          @default(now())
  completedAt             DateTime?
  questionAttempts        Json              @default("[]")
  correctAnswers          Int               @default(0)
  answeredQuestions       Int               @default(0)
  currentBlock            Int               @default(0)
  status                  ExamAttemptStatus @default(IN_PROGRESS)
  blockStartedAt          DateTime?
  activeQuestionId        String?
  activeQuestionStartedAt DateTime?
  exam                    Exam              @relation(fields: [examId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])

  @@index([examId])
  @@index([userId])
  @@index([userId, status])
}

model Exam {
  id                 String         @id @default(cuid())
  title              String
  durationMin        Int
  createdAt          DateTime       @default(now())
  blockCount         Int            @default(8)
  description        String?
  isActive           Boolean        @default(true)
  questionsPerBlock  Int            @default(20)
  secondsPerQuestion Int            @default(90)
  selectionSettings  Json?
  updatedAt          DateTime       @updatedAt
  mode               ExamMode       @default(ADMIN)
  createdById        String?
  createdBy          User?          @relation("ExamCreator", fields: [createdById], references: [id])
  examAttempts       ExamAttempt[]
  questions          ExamQuestion[]
}

model Flashcard {
  id         String    @id @default(cuid())
  userId     String
  front      String
  back       String
  nextReview DateTime?
  easeFactor Float?
  interval   Int?
  user       User      @relation(fields: [userId], references: [id])
}

model Subject {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  studySessions StudySession[]
  topics        Topic[]
}

model Topic {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  parentId  String?
  createdAt DateTime   @default(now())
  questions Question[]
  parent    Topic?     @relation("TopicHierarchy", fields: [parentId], references: [id])
  children  Topic[]    @relation("TopicHierarchy")
  subject   Subject    @relation(fields: [subjectId], references: [id])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  tokenCount     Int?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model ArenaBattle {
  id              String                @id @default(cuid())
  player1Id       String
  player2Id       String
  mode            ArenaBattleMode       @default(HEAD_TO_HEAD)
  status          ArenaBattleStatus     @default(PENDING)
  player1Score    Int                   @default(0)
  player2Score    Int                   @default(0)
  player1Answered Int                   @default(0)
  player2Answered Int                   @default(0)
  winnerId        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  durationSec     Int                   @default(300)
  player1         User                  @relation("ArenaPlayer1", fields: [player1Id], references: [id])
  player2         User                  @relation("ArenaPlayer2", fields: [player2Id], references: [id])
  answers         ArenaBattleAnswer[]
  questions       ArenaBattleQuestion[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
}

model ArenaBattleQuestion {
  id         String      @id @default(cuid())
  battleId   String
  questionId String
  order      Int         @default(0)
  battle     ArenaBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])

  @@unique([battleId, questionId])
  @@index([battleId])
}

model ArenaBattleAnswer {
  id               String      @id @default(cuid())
  battleId         String
  questionId       String
  userId           String
  selectedChoiceId String?
  isCorrect        Boolean     @default(false)
  timeSpentSec     Int         @default(0)
  createdAt        DateTime    @default(now())
  battle           ArenaBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@unique([battleId, questionId, userId])
  @@index([battleId])
  @@index([userId])
}

model ArenaLeaderboardEntry {
  id            String   @id @default(cuid())
  userId        String   @unique
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  points        Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([points])
}

model ArenaGuild {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  leaderId    String?
  points      Int                @default(0)
  members     ArenaGuildMember[]
  votes       ArenaGuildVote[]
  messages    GuildMessage[]
}

model ArenaGuildMember {
  id                 String         @id @default(cuid())
  guildId            String
  userId             String
  role               ArenaGuildRole @default(MEMBER)
  joinedAt           DateTime       @default(now())
  inCompetitionSquad Boolean        @default(false)
  guild              ArenaGuild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id])

  @@unique([guildId, userId])
  @@index([userId])
}

model ArenaGuildVote {
  id          String     @id @default(cuid())
  guildId     String
  voterId     String
  candidateId String
  createdAt   DateTime   @default(now())
  candidate   User       @relation("GuildCandidate", fields: [candidateId], references: [id])
  guild       ArenaGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  voter       User       @relation("GuildVoter", fields: [voterId], references: [id])

  @@unique([guildId, voterId])
  @@index([guildId])
}

model ArenaTeamBattle {
  id           String                    @id @default(cuid())
  teamAId      String
  teamBId      String
  status       ArenaBattleStatus         @default(PENDING)
  durationSec  Int                       @default(300)
  teamAScore   Int                       @default(0)
  teamBScore   Int                       @default(0)
  winnerTeamId String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  answers      ArenaTeamBattleAnswer[]
  members      ArenaTeamBattleMember[]
  questions    ArenaTeamBattleQuestion[]

  @@index([teamAId])
  @@index([teamBId])
  @@index([status])
}

model ArenaTeamBattleMember {
  id       String          @id @default(cuid())
  battleId String
  userId   String
  teamId   String
  joinedAt DateTime        @default(now())
  battle   ArenaTeamBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@unique([battleId, userId])
  @@index([battleId])
}

model ArenaTeamBattleQuestion {
  id         String          @id @default(cuid())
  battleId   String
  questionId String
  order      Int             @default(0)
  battle     ArenaTeamBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id])

  @@unique([battleId, questionId])
  @@index([battleId])
}

model ArenaTeamBattleAnswer {
  id               String          @id @default(cuid())
  battleId         String
  questionId       String
  userId           String
  teamId           String
  selectedChoiceId String?
  isCorrect        Boolean         @default(false)
  timeSpentSec     Int             @default(0)
  createdAt        DateTime        @default(now())
  battle           ArenaTeamBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id])
  user             User            @relation(fields: [userId], references: [id])

  @@unique([battleId, questionId, userId])
  @@index([battleId])
}

model Friend {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  receiver   User      @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
}

model GuildMessage {
  id        String     @id @default(cuid())
  guildId   String
  senderId  String
  content   String
  createdAt DateTime   @default(now())
  guild     ArenaGuild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

enum Role {
  STUDENT
  ADMIN
  REVIEWER
}

enum StudentType {
  MEDICAL_GRADUATE
  GRADUATE
  INTERMEDIATE_GRADUATE_IMG
}

enum ExamType {
  USMLE_STEP_1
  USMLE_STEP_2_CK
  USMLE_STEP_3
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
  HUMAN_GENERATED
}

enum QuestionStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  VALIDATING
  PROCESSING
  CHUNKED
  EMBEDDING
  INDEXED
  READY
  FAILED
  RETRYING
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum QuestionSourceType {
  BUZZWORD
  VIGNETTE
}

enum CognitiveLevel {
  RECALL
  APPLICATION
  CLINICAL_REASONING
  ANALYSIS
}

enum AiReviewVerdict {
  PASS
  FAIL
}

enum AiReviewTrigger {
  MANUAL
  AUTOMATIC
  RE_REVIEW
  AFTER_HUMAN_REJECTION
  AFTER_EDIT
  AFTER_AI_CORRECTION
}

enum QuestionRevisionType {
  ORIGINAL
  HUMAN_EDIT
